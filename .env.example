# Copy to .env.local (local) or set in your host's dashboard (production).
# Everything is optional for browsing the site; the contact form needs at
# least one delivery channel in production (RESEND_API_KEY or LEADS_WEBHOOK_URL).

# --- Contact form: email delivery through Resend (https://resend.com)
RESEND_API_KEY=
# Where walkthrough requests go (default: hello@acceleret.com)
LEADS_TO_EMAIL=hello@acceleret.com
# Sender; the domain must be verified in Resend
LEADS_FROM_EMAIL=Acceleret website <website@acceleret.com>

# --- Contact form: a copy the founders can see (Google Sheet, admin, automation)
# Each request is POSTed here as JSON. A Google Apps Script web app that appends
# a row to a Sheet works well; an automation tool (Make/Zapier) can also send the
# optional WhatsApp notification to the founders from the same hook.
LEADS_WEBHOOK_URL=
# Sent as the X-Leads-Secret header so the receiver can reject other callers
LEADS_WEBHOOK_SECRET=

# --- Contact form: write requests to .data/leads.jsonl (always on in development)
# Only useful on a host with a writable disk.
LEADS_FILE=

# --- Analytics: Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# --- Google Search Console: HTML-tag verification token
GOOGLE_SITE_VERIFICATION=
